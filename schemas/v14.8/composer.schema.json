{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://7fit.local/schemas/v14.8/composer.schema.json",
  "title": "7Fit V14.8 Composer",
  "type": "object",
  "$defs": {
    "mainCandidate": {
      "type": "object",
      "required": ["id", "tier"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "tier": {"enum": ["T1", "T2", "T3", "T4"]}
      },
      "additionalProperties": false
    },
    "mainMode": {
      "type": "object",
      "required": ["code", "name", "pattern", "patternKey", "candidates"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "subtitle": {"type": "string"},
        "pattern": {"type": "string", "minLength": 1},
        "patternKey": {"type": "string", "minLength": 1},
        "candidates": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/mainCandidate"}
        },
        "prescriptionByTier": {
          "type": "object",
          "properties": {
            "T1": {"type": "string"},
            "T2": {"type": "string"},
            "T3": {"type": "string"},
            "T4": {"type": "string"}
          },
          "additionalProperties": false
        },
        "tierNoteByTier": {
          "type": "object",
          "properties": {
            "T1": {"type": "string"},
            "T2": {"type": "string"},
            "T3": {"type": "string"},
            "T4": {"type": "string"}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    }
  },
  "required": ["lowerModes", "upperModes", "levelMap", "supportMap", "coreMap", "coreDemands", "auxiliaryRules", "officialPresetMap"],
  "properties": {
    "lowerModes": {
      "type": "object",
      "required": ["squat", "hinge", "hip_extension", "single_leg_squat", "single_leg_hinge"],
      "minProperties": 5,
      "maxProperties": 5,
      "additionalProperties": {"$ref": "#/$defs/mainMode"}
    },
    "upperModes": {
      "type": "object",
      "required": ["horizontal_pull", "vertical_pull", "horizontal_push", "vertical_push"],
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": {"$ref": "#/$defs/mainMode"}
    },
    "levelMap": {
      "type": "object",
      "required": ["L1", "L2", "L3", "L4"],
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": true
    },
    "supportMap": {
      "type": "object",
      "required": ["L1", "L2", "L3", "L4"],
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": true
    },
    "coreMap": {
      "type": "object",
      "required": ["L1", "L2", "L3", "L4"],
      "minProperties": 4,
      "maxProperties": 4,
      "additionalProperties": true
    },
    "coreDemands": {
      "type": "object",
      "required": ["anti_extension", "anti_rotation", "anti_lateral_flexion", "dynamic_rotation", "breathing_pressure", "loaded_integration"],
      "properties": {
        "anti_extension": {
          "type": "object",
          "required": ["name", "keywords"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        },
        "anti_rotation": {
          "type": "object",
          "required": ["name", "keywords"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        },
        "anti_lateral_flexion": {
          "type": "object",
          "required": ["name", "keywords"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        },
        "dynamic_rotation": {
          "type": "object",
          "required": ["name", "keywords"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        },
        "breathing_pressure": {
          "type": "object",
          "required": ["name", "keywords"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        },
        "loaded_integration": {
          "type": "object",
          "required": ["name", "keywords"],
          "properties": {
            "name": {"type": "string", "minLength": 1},
            "keywords": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": false
    },
    "auxiliaryRules": {
      "type": "object",
      "required": ["lower", "upper"],
      "additionalProperties": true
    },
    "officialPresetMap": {
      "type": "object",
      "required": ["F111-01", "F111-02", "F111-03", "F111-04", "F111-05", "F111-06", "F111-07", "F111-08"],
      "minProperties": 8,
      "maxProperties": 8,
      "additionalProperties": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "prefixItems": [
          {"type": "string", "minLength": 1},
          {"type": "string", "minLength": 1}
        ],
        "items": false
      }
    }
  },
  "additionalProperties": true
}
