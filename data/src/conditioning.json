      "v1Status": "ACTIVE"
    },
    "BALL": {
      "modalityId": "BALL",
      "name": "药球",
      "description": "药球砸地、墙球、推掷等球类体能动作。",
      "v1Status": "ACTIVE"
    },
    "SIMPLE_STRENGTH": {
      "modalityId": "SIMPLE_STRENGTH",
