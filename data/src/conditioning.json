      "v1Status": "ACTIVE"
    },
    "POWER": {
      "modalityId": "POWER",
      "name": "爆发功率",
      "description": "强调速度、爆发与质量控制的低复杂度功率动作。",
      "v1Status": "ACTIVE"
    },
    "CORE_INTEGRATION": {
      "modalityId": "CORE_INTEGRATION",
