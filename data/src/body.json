      "name": "主项",
      "description": "当日主要刺激目标的核心动作。"
    },
    "SECONDARY": {
      "id": "SECONDARY",
      "name": "次主项",
      "description": "补充主要刺激方向并改变动作模式、角度或负重路径。"
    },
    "ACCESSORY": {
      "id": "ACCESSORY",
      "name": "辅助",
      "description": "补齐目标肌群或训练结构，不承担当日主要负荷。"
    },
    "ISOLATION": {
      "id": "ISOLATION",
      "name": "孤立",
      "description": "局部肌群导向、低全身疲劳的孤立或近孤立动作。"
    },
    "OPTIONAL": {
      "id": "OPTIONAL",
      "name": "可选补充",
      "description": "在等级、时间预算或个体需求允许时追加。"
    }
  },
